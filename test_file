name: Run Snowflake Migrations

on:
  push:
    branches: [ main ]
  workflow_dispatch:
    inputs:
      connection:
        description: 'Snowflake connection to use (as defined in .snowflake/config.toml)'
        required: true
        default: 'myconnection'
        type: choice
        options:
          - myconnection
          - devconnection
          - preprodconnection

jobs:
  migrate:
    runs-on: ubuntu-latest
    env:
      CONNECTION_NAME: ${{ github.event.inputs.connection || 'myconnection' }}

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Snowflake CLI
        uses: snowflakedb/snowflake-cli-action@v2.0
        with:
          default-config-file-path: ".snowflake/config.toml"

      - name: Run migration scripts
        id: migrations
        env:
          SNOWFLAKE_CONNECTIONS_MYCONNECTION_AUTHENTICATOR: SNOWFLAKE_JWT
          SNOWFLAKE_CONNECTIONS_MYCONNECTION_AUTHENTICATOR: ${{ secrets.SNOWFLAKE_CONNECTIONS_MYCONNECTION_AUTHENTICATOR }}
          SNOWFLAKE_CONNECTIONS_MYCONNECTION_USER: ${{ secrets.SNOWFLAKE_CONNECTIONS_MYCONNECTION_USER }}
          SNOWFLAKE_CONNECTIONS_MYCONNECTION_ACCOUNT: ${{ secrets.SNOWFLAKE_CONNECTIONS_MYCONNECTION_ACCOUNT }}
          SNOWFLAKE_CONNECTIONS_MYCONNECTION_PRIVATE_KEY_RAW: ${{ secrets.SNOWFLAKE_CONNECTIONS_MYCONNECTION_PRIVATE_KEY_RAW }}
          SNOWFLAKE_CONNECTIONS_DEVCONNECTION_AUTHENTICATOR: ${{ secrets.SNOWFLAKE_CONNECTIONS_DEVCONNECTION_AUTHENTICATOR }}
          SNOWFLAKE_CONNECTIONS_DEVCONNECTION_USER: ${{ secrets.SNOWFLAKE_CONNECTIONS_DEVCONNECTION_USER }}
          SNOWFLAKE_CONNECTIONS_DEVCONNECTION_ACCOUNT: ${{ secrets.SNOWFLAKE_CONNECTIONS_DEVCONNECTION_ACCOUNT }}
          SNOWFLAKE_CONNECTIONS_DEVCONNECTION_PRIVATE_KEY_RAW: ${{ secrets.SNOWFLAKE_CONNECTIONS_DEVCONNECTION_PRIVATE_KEY_RAW }}
          SNOWFLAKE_CONNECTIONS_PREPRODCONNECTION_AUTHENTICATOR: ${{ secrets.SNOWFLAKE_CONNECTIONS_PREPRODCONNECTION_AUTHENTICATOR }}
          SNOWFLAKE_CONNECTIONS_PREPRODCONNECTION_USER: ${{ secrets.SNOWFLAKE_CONNECTIONS_PREPRODCONNECTION_USER }}
          SNOWFLAKE_CONNECTIONS_PREPRODCONNECTION_ACCOUNT: ${{ secrets.SNOWFLAKE_CONNECTIONS_PREPRODCONNECTION_ACCOUNT }}
          SNOWFLAKE_CONNECTIONS_PREPRODCONNECTION_PRIVATE_KEY_RAW: ${{ secrets.SNOWFLAKE_CONNECTIONS_PREPRODCONNECTION_PRIVATE_KEY_RAW }}
        run: |
          for dir in $(ls -d migration-scripts/v* | sort); do
            for file in $dir/*.sql; do
              echo "Running $file"
              snowcli sql execute -f $file --connection $CONNECTION_NAME --database $DATABASE --warehouse $WAREHOUSE
            done
          done

      - name: Run rollback scripts if migration fails
        if: failure()
        env:
          SNOWFLAKE_CONNECTIONS_MYCONNECTION_AUTHENTICATOR: SNOWFLAKE_JWT
          SNOWFLAKE_CONNECTIONS_MYCONNECTION_AUTHENTICATOR: ${{ secrets.SNOWFLAKE_CONNECTIONS_MYCONNECTION_AUTHENTICATOR }}
          SNOWFLAKE_CONNECTIONS_MYCONNECTION_USER: ${{ secrets.SNOWFLAKE_CONNECTIONS_MYCONNECTION_USER }}
          SNOWFLAKE_CONNECTIONS_MYCONNECTION_ACCOUNT: ${{ secrets.SNOWFLAKE_CONNECTIONS_MYCONNECTION_ACCOUNT }}
          SNOWFLAKE_CONNECTIONS_MYCONNECTION_PRIVATE_KEY_RAW: ${{ secrets.SNOWFLAKE_CONNECTIONS_MYCONNECTION_PRIVATE_KEY_RAW }}
          SNOWFLAKE_CONNECTIONS_DEVCONNECTION_AUTHENTICATOR: ${{ secrets.SNOWFLAKE_CONNECTIONS_DEVCONNECTION_AUTHENTICATOR }}
          SNOWFLAKE_CONNECTIONS_DEVCONNECTION_USER: ${{ secrets.SNOWFLAKE_CONNECTIONS_DEVCONNECTION_USER }}
          SNOWFLAKE_CONNECTIONS_DEVCONNECTION_ACCOUNT: ${{ secrets.SNOWFLAKE_CONNECTIONS_DEVCONNECTION_ACCOUNT }}
          SNOWFLAKE_CONNECTIONS_DEVCONNECTION_PRIVATE_KEY_RAW: ${{ secrets.SNOWFLAKE_CONNECTIONS_DEVCONNECTION_PRIVATE_KEY_RAW }}
          SNOWFLAKE_CONNECTIONS_PREPRODCONNECTION_AUTHENTICATOR: ${{ secrets.SNOWFLAKE_CONNECTIONS_PREPRODCONNECTION_AUTHENTICATOR }}
          SNOWFLAKE_CONNECTIONS_PREPRODCONNECTION_USER: ${{ secrets.SNOWFLAKE_CONNECTIONS_PREPRODCONNECTION_USER }}
          SNOWFLAKE_CONNECTIONS_PREPRODCONNECTION_ACCOUNT: ${{ secrets.SNOWFLAKE_CONNECTIONS_PREPRODCONNECTION_ACCOUNT }}
          SNOWFLAKE_CONNECTIONS_PREPRODCONNECTION_PRIVATE_KEY_RAW: ${{ secrets.SNOWFLAKE_CONNECTIONS_PREPRODCONNECTION_PRIVATE_KEY_RAW }}
        run: |
          echo "Migration failed. Running rollback scripts..."
          for dir in $(ls -d migration-scripts/v* | sort -r); do
            if [ -f "$dir/rollback.sql" ]; then
              echo "Running rollback for $dir"
              snowcli sql execute -f "$dir/rollback.sql" --connection $CONNECTION_NAME
            fi
          done